// Prisma Schema for Recruitment Platform Modular Monolith
// Phase 00: Foundation & Database Integration Direction
// Domain entities (Users, Companies, Jobs, Applications, etc.) will be introduced in Phases 03 & 04.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
